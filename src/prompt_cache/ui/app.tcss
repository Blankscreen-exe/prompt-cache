/* All styling lives here, not inline, so the theme is one file to change.
   Dense, calm, one accent colour used only for focus and selection. */

Screen {
    background: $surface;
}

#main, #editor-main {
    height: 1fr;
    padding: 1 2 0 2;
}

#search {
    border: tall $primary;
    background: $boost;
}

#search:focus {
    border: tall $accent;
}

#results, #trash-list {
    height: 1fr;
    border: none;
    background: $surface;
    padding: 1 0 0 0;
}

#results > .option-list--option-highlighted,
#trash-list > .option-list--option-highlighted {
    background: $accent 25%;
    color: $text;
}

#editor-meta, #trash-title {
    padding: 0 1 1 1;
    color: $text-muted;
}

#editor-body {
    height: 1fr;
    border: tall $primary;
    background: $boost;
}

#editor-body:focus {
    border: tall $accent;
}

Footer {
    background: $panel;
}

/* ---- fill form ---- */

#fill-main {
    height: 1fr;
    padding: 1 2 0 2;
}

#fill-title, #preview-label {
    padding: 0 1;
    color: $text-muted;
}

#fill-fields {
    height: auto;
    max-height: 50%;
}

.field-label {
    padding: 1 1 0 1;
}

#fill-fields TextArea {
    height: auto;
    max-height: 8;
    border: tall $primary;
    background: $boost;
}

#fill-fields TextArea:focus {
    border: tall $accent;
}

#fill-preview {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#copy-button {
    margin: 1 1 0 1;
    width: auto;
}
