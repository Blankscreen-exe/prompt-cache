/* All styling lives here, not inline, so the theme is one file to change.
   Dense, calm, one accent colour used only for focus and selection. */

Screen {
    background: $surface;
}

#main, #editor-main {
    height: 1fr;
    padding: 1 2 0 2;
}

#search {
    border: tall $primary;
    background: $boost;
}

#search:focus {
    border: tall $accent;
}

#results, #trash-list {
    height: 1fr;
    border: none;
    background: $surface;
    padding: 1 0 0 0;
}

#results > .option-list--option-highlighted,
#trash-list > .option-list--option-highlighted {
    background: $accent 25%;
    color: $text;
}

#editor-meta, #trash-title {
    padding: 0 1 1 1;
    color: $text-muted;
}

#editor-body {
    height: 1fr;
    border: tall $primary;
    background: $boost;
}

#editor-body:focus {
    border: tall $accent;
}

Footer {
    background: $panel;
}

/* ---- fill form ---- */

#fill-main {
    height: 1fr;
    padding: 1 2 0 2;
}

#fill-title, #preview-label {
    padding: 0 1;
    color: $text-muted;
}

#fill-fields {
    height: auto;
    max-height: 50%;
}

.field-label {
    padding: 1 1 0 1;
}

#fill-fields TextArea {
    height: auto;
    max-height: 8;
    border: tall $primary;
    background: $boost;
}

#fill-fields TextArea:focus {
    border: tall $accent;
}

#fill-preview {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#copy-button {
    margin: 1 1 0 1;
    width: auto;
}

/* ---- block picker ---- */

BlockPicker {
    align: center middle;
}

#picker {
    width: 70%;
    max-width: 80;
    height: auto;
    max-height: 60%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#picker-title {
    padding: 0 0 1 0;
}

#picker-list {
    height: auto;
    max-height: 14;
    border: none;
}

/* ---- conversation ---- */

#thread-main {
    height: 1fr;
    padding: 1 2 0 2;
}

#thread-title {
    padding: 0 1 1 1;
}

.section-label {
    padding: 0 1;
    color: $text-muted;
}

#thread-values {
    height: auto;
    max-height: 10;
    border: none;
}

#thread-value-name {
    margin: 0 0 1 0;
    border: tall $primary;
    background: $boost;
}

#thread-value-name:focus {
    border: tall $accent;
}

#thread-history {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

/* ---- history & settings ---- */

#history-main, #settings-main {
    height: 1fr;
    padding: 1 2 0 2;
}

#history-title, #settings-title, #settings-status {
    padding: 0 1 1 1;
}

#history-list {
    height: auto;
    max-height: 10;
    border: none;
}

#history-diff, #settings-body {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#settings-path {
    border: tall $primary;
    background: $boost;
}

#settings-path:focus {
    border: tall $accent;
}
