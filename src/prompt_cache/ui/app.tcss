/* All styling lives here, not inline, so the theme is one file to change.
   Dense, calm, one accent colour used only for focus and selection. */

Screen {
    background: $surface;
}

#main, #editor-main {
    height: 1fr;
    padding: 1 2 0 2;
}

#search {
    border: tall $primary;
    background: $boost;
}

#search:focus {
    border: tall $accent;
}

#results, #trash-list {
    height: 1fr;
    border: none;
    background: $surface;
    padding: 1 0 0 0;
}

#results > .option-list--option-highlighted,
#trash-list > .option-list--option-highlighted {
    background: $accent 25%;
    color: $text;
}

#editor-meta, #trash-title {
    padding: 0 1 1 1;
    color: $text-muted;
}

#editor-body {
    height: 1fr;
    border: tall $primary;
    background: $boost;
}

#editor-body:focus {
    border: tall $accent;
}

Footer {
    background: $panel;
}
